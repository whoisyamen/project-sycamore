---
import Base from '../../layouts/Base.astro';
import { loadData } from '../../data/loader';
import { boards } from '../../client/render';
const context = await loadData();
---

<Base title="Boards — Sycamore" activeNav="boards" context={context}>
  <main id="main" class="content-page" tabindex="-1">
    <header class="page-heading">
      <p class="eyebrow">EXPLORE THE COVERAGE</p><h1>
        Follow a thread<span class="accent">.</span>
      </h1><p>Cyber, geopolitics, maritime, and military reporting. Organized for a closer look.</p>
    </header><div data-collection="boards" set:html={boards(context.events)} />
  </main>
</Base>
