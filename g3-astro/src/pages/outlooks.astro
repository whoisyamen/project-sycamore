---
import Base from '../layouts/Base.astro';
import { loadData } from '../data/loader';
const context = await loadData();
---

<Base title="Outlooks — Sycamore" activeNav="briefing" context={context}>
  <main id="main" class="content-page" tabindex="-1">
    <header class="page-heading">
      <p class="eyebrow">LOOKING AHEAD</p><h1>
        Follow the reporting<span class="accent">.</span>
      </h1><p>
        The sample outlooks have been retired. Explore recent events and original sources in the
        briefing.
      </p>
    </header><a href="/briefing" class="button">Read the briefing ↗</a>
  </main>
</Base>
