<aside
  id="detail-panel"
  class="detail-panel panel"
  role="dialog"
  aria-labelledby="detail-title"
  tabindex="-1"
  hidden
>
  <div class="detail-toolbar">
    <span class="eyebrow">EVENT DETAIL</span><button
      id="close-detail"
      class="icon-button"
      aria-label="Close event details">×</button
    >
  </div>
  <div class="detail-scroll" id="detail-body"></div>
  <footer class="detail-actions">
    <button id="share-event" class="button"
      >Copy event link <span aria-hidden="true">↗</span></button
    ><span id="share-status" role="status"></span>
  </footer>
</aside>
