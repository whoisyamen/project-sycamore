---
import EventCard from './EventCard.astro';
import { TOPIC_LABELS, SEVERITY_LABELS, type Event } from '../data/types';
interface Props {
  events: Event[];
}
const { events } = Astro.props;
---

<aside class="feed-panel panel" id="feed-panel" aria-label="Event feed">
  <div class="feed-heading">
    <div>
      <p class="eyebrow">THE WORLD, IN VIEW</p><h1>Latest signals<span class="accent">.</span></h1>
    </div><span class="count-badge" id="feed-count">{events.length}</span>
  </div>
  <div class="feed-controls">
    <label class="search-field"
      ><span aria-hidden="true">⌕</span><input
        type="search"
        id="search"
        maxlength="200"
        placeholder="Search events or places"
        aria-label="Search events or places"
      /><kbd aria-hidden="true">/</kbd></label
    >
    <div class="topic-chips" role="group" aria-label="Topic">
      <button class="chip" data-topic="all" aria-pressed="true">All signals</button>{
        Object.entries(TOPIC_LABELS).map(([key, label]) => (
          <button class="chip" data-topic={key} aria-pressed="false">
            {label.charAt(0) + label.slice(1).toLowerCase()}
          </button>
        ))
      }
    </div>
    <div class="filter-row">
      <label
        ><span class="sr-only">Severity</span><select id="severity"
          ><option value="all">All severity</option>{
            Object.entries(SEVERITY_LABELS).map(([key, label]) => (
              <option value={key}>{label.charAt(0) + label.slice(1).toLowerCase()}</option>
            ))
          }</select
        ></label
      ><label
        ><span class="sr-only">Time range</span><select id="range"
          ><option value="all">All time</option><option value="24h">Last 24 hours</option><option
            value="7d">Last 7 days</option
          ><option value="30d">Last 30 days</option></select
        ></label
      ><button id="reset-filters" class="text-button" title="Reset all filters">Reset</button>
    </div>
    <div id="legacy-mode" class="fine-print" hidden></div>
  </div>
  <div class="feed-list" id="feed-list" tabindex="-1">
    {[...events].sort((a, b) => b.ts - a.ts).map((event) => <EventCard event={event} dashboard />)}{
      events.length === 0 && (
        <p class="empty-state">
          No events available. Updates will appear here when reporting arrives.
        </p>
      )
    }
  </div>
  <footer class="feed-footer">
    <span class="status-dot"></span> Sourced reporting. A wider perspective.
  </footer>
</aside>
