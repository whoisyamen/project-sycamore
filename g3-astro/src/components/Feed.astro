---
import EventCard from './EventCard.astro';
import { LENS_LABELS } from '../data/threat';
import { TOPIC_LABELS, SEVERITY_LABELS, type Event } from '../data/types';
interface Props {
  events: Event[];
}
const { events } = Astro.props;
const sources = [...new Set(events.map((event) => event.src))].sort((a, b) => a.localeCompare(b));
const lenses = (Object.keys(LENS_LABELS) as (keyof typeof LENS_LABELS)[]).filter(
  (key) => key !== 'all',
);
---

<aside class="feed-panel panel" id="feed-panel" aria-label="Event feed">
  <div class="feed-heading">
    <div>
      <p class="eyebrow">THREAT INTELLIGENCE / ALL REPORTING</p><h1>
        Signal feed<span class="accent">.</span>
      </h1>
      <p class="feed-subhead">
        Every article behind the globe, as tiles. Filter by lens, topic, severity, source, and time
        — no map required.
      </p>
    </div><span class="count-badge" id="feed-count">{events.length}</span>
  </div>
  <div class="feed-controls">
    <label class="search-field"
      ><span aria-hidden="true">⌕</span><input
        type="search"
        id="search"
        maxlength="200"
        placeholder="Search reporting or places"
        aria-label="Search reporting or places"
      /><kbd aria-hidden="true">/</kbd></label
    >
    <div class="topic-chips" role="group" aria-label="Topic">
      <button class="chip" data-topic="all" aria-pressed="true">All signals</button>{
        Object.entries(TOPIC_LABELS).map(([key, label]) => (
          <button class="chip" data-topic={key} aria-pressed="false">
            {label.charAt(0) + label.slice(1).toLowerCase()}
          </button>
        ))
      }
    </div>
    <div class="topic-chips lens-chips" role="group" aria-label="Threat lens">
      <span class="chip-scope" aria-hidden="true">LENS</span><button
        class="chip"
        data-lens="all"
        aria-pressed="true">All reporting</button
      >{
        lenses.map((key) => (
          <button class="chip" data-lens={key} aria-pressed="false">
            {LENS_LABELS[key]}
          </button>
        ))
      }
    </div>
    <div class="filter-row">
      <label
        ><span class="sr-only">Severity</span><select id="severity"
          ><option value="all">All severity</option>{
            Object.entries(SEVERITY_LABELS).map(([key, label]) => (
              <option value={key}>{label.charAt(0) + label.slice(1).toLowerCase()}</option>
            ))
          }</select
        ></label
      ><label
        ><span class="sr-only">Time range</span><select id="range"
          ><option value="all">All time</option><option value="24h">Last 24 hours</option><option
            value="7d">Last 7 days</option
          ><option value="30d">Last 30 days</option></select
        ></label
      ><label
        ><span class="sr-only">Sort order</span><select id="sort"
          ><option value="newest">Newest first</option><option value="oldest">Oldest first</option
          ><option value="severity">Severity first</option></select
        ></label
      >
    </div>
    <div class="filter-row">
      <label
        ><span class="sr-only">Source</span><select id="source"
          ><option value="all">All sources</option>{
            sources.map((source) => <option value={source}>{source}</option>)
          }</select
        ></label
      ><label
        ><span class="sr-only">Corroboration</span><select id="mode"
          ><option value="all">All reporting</option><option value="pulse">Corroborated</option
          ><option value="news">Single source</option></select
        ></label
      ><button id="reset-filters" class="text-button" title="Reset all filters">Reset</button>
    </div>
    <div id="legacy-mode" class="fine-print" hidden></div>
  </div>
  <div class="feed-list" id="feed-list" tabindex="-1">
    {[...events].sort((a, b) => b.ts - a.ts).map((event) => <EventCard event={event} dashboard />)}{
      events.length === 0 && (
        <p class="empty-state">
          No events available. Updates will appear here when reporting arrives.
        </p>
      )
    }
  </div>
  <footer class="feed-footer">
    <span class="status-dot"></span> Reporting refreshes every 60s while visible.
  </footer>
</aside>
