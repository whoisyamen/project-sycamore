{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sycamore intelligence record (internal)",
  "description": "Internal storage shape for one event's intelligence record. Public projections are index.json and detail.json. Never served directly. Shapes are fully inline (no cross-file $ref) so the Python subset validator and Ajv validate identical bounds.",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventUid",
    "eventRevisionUid",
    "eventId",
    "projectionHash",
    "generatedAt",
    "evidence",
    "entities",
    "timeline",
    "related",
    "truncated"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventUid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Canonical lowercase UUID assigned once and persisted."
    },
    "eventRevisionUid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Existing numeric v1 event ID; never renumbered."
    },
    "projectionHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of canonical JSON of the whole selected v1 event."
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000,
      "description": "Enrichment generation time, ms UTC."
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "evidenceUid",
          "sourceUid",
          "sourceRevisionUid",
          "eventRevisionUids",
          "providerUid",
          "sourceUrl",
          "title",
          "publishedAt",
          "observedAt",
          "excerpt",
          "evidenceKind",
          "reportingOriginUid",
          "independence",
          "status"
        ],
        "properties": {
          "evidenceUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "sourceUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "sourceRevisionUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "eventRevisionUids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
          },
          "providerUid": { "type": "string", "minLength": 1, "maxLength": 80 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
          "title": { "type": "string", "maxLength": 500 },
          "publishedAt": { "type": ["integer", "null"], "minimum": 0, "maximum": 8640000000000000 },
          "observedAt": { "type": "integer", "minimum": 0, "maximum": 8640000000000000 },
          "excerpt": { "type": ["string", "null"], "maxLength": 600 },
          "evidenceKind": { "type": "string", "enum": ["source_text", "metadata_only"] },
          "reportingOriginUid": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "independence": { "type": "string", "enum": ["known_primary", "known_syndicated", "unknown"] },
          "status": { "type": "string", "enum": ["active", "corrected", "retracted", "removed"] }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "entityUid",
          "kind",
          "canonicalValue",
          "displayName",
          "resolution",
          "mentions"
        ],
        "properties": {
          "entityUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "kind": {
            "type": "string",
            "enum": ["country", "region", "domain", "ip", "cidr", "asn", "cve", "organization"]
          },
          "canonicalValue": { "type": "string", "minLength": 1, "maxLength": 253 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 300 },
          "resolution": { "type": "string", "enum": ["exact", "reviewed_alias"] },
          "mentions": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "mentionUid",
                "evidenceUid",
                "role",
                "field",
                "rawText",
                "start",
                "end",
                "methodVersion"
              ],
              "properties": {
                "mentionUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
                "evidenceUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
                "role": { "type": "string", "enum": ["subject", "publisher", "mentioned", "affected", "uncertain"] },
                "field": { "type": "string", "enum": ["title", "summary", "structured_subject"] },
                "rawText": { "type": "string", "minLength": 1, "maxLength": 300 },
                "start": { "type": ["integer", "null"], "minimum": 0 },
                "end": { "type": ["integer", "null"], "minimum": 0 },
                "methodVersion": { "type": "string", "minLength": 1, "maxLength": 80 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "entryUid",
          "kind",
          "observedAt",
          "sourcePublishedAt",
          "eventRevisionUid",
          "label",
          "evidenceUids"
        ],
        "properties": {
          "entryUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "kind": {
            "type": "string",
            "enum": ["first_observed", "new_source", "source_revised", "correction", "retraction"]
          },
          "observedAt": { "type": "integer", "minimum": 0, "maximum": 8640000000000000 },
          "sourcePublishedAt": { "type": ["integer", "null"], "minimum": 0, "maximum": 8640000000000000 },
          "eventRevisionUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 300 },
          "evidenceUids": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
          }
        },
        "additionalProperties": false
      }
    },
    "related": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["edgeUid", "kind", "target", "reasons", "methodVersion"],
        "properties": {
          "edgeUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "kind": { "type": "string", "enum": ["shared_evidence"] },
          "target": {
            "type": "object",
            "required": ["eventUid", "eventRevisionUid", "eventId", "title", "publishedAt", "locationLabel", "sourceUrls"],
            "properties": {
              "eventUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "eventRevisionUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "eventId": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
              "title": { "type": "string", "maxLength": 500 },
              "publishedAt": { "type": ["integer", "null"], "minimum": 0, "maximum": 8640000000000000 },
              "locationLabel": { "type": ["string", "null"], "maxLength": 300 },
              "sourceUrls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 }
              }
            },
            "additionalProperties": false
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["code", "entityUid", "evidenceUids", "label"],
              "properties": {
                "code": {
                  "type": "string",
                  "enum": ["shared_subject_cve", "shared_subject_infrastructure", "shared_subject_organization"]
                },
                "entityUid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
                "evidenceUids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
                },
                "label": { "type": "string", "minLength": 1, "maxLength": 300 }
              },
              "additionalProperties": false
            }
          },
          "methodVersion": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "object",
      "required": ["evidence", "entities", "timeline", "related"],
      "properties": {
        "evidence": { "type": "boolean" },
        "entities": { "type": "boolean" },
        "timeline": { "type": "boolean" },
        "related": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}